# Demo is explicit. Omission in product code still defaults to legacy OAuth.
VITE_AUTH_MODE=demo
VITE_BACK_URL=http://127.0.0.1:8080
# The browser E2E runner supplies its own same-origin HTTPS address and disables env-file loading.
