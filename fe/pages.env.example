# Documentation only; do not load this file into the browser/Vite environment.
# Pages project root: fe. Build output: dist. Functions stay at fe/functions.
# Configure this server binding independently for Production and Preview.
# Leave Preview unset until its separate non-production backend is approved.
# A missing binding returns 503; it never falls back to a production URL.
BACKEND_ORIGIN=https://<approved-backend-host>
# public-demo server-only Pages secret binding; never add a VITE_ variant.
# Use the same canonical base64url 32-byte secret as the backend.
DEMO_GATEWAY_SECRET=<server-secret-binding>

# Browser build settings (not server bindings):
VITE_AUTH_MODE=demo
# Use the exact browser Pages origin, never the upstream Render origin.
# The demo interceptor requires an absolute URL to enforce its origin boundary.
VITE_BACK_URL=https://<approved-pages-host>
