# Reviewed runtime documentation; neither Spring nor Docker loads this file automatically.
# No real credentials belong here. Do not pass secrets as Docker build arguments.
SPRING_PROFILES_ACTIVE=demo,render
APP_DEMO_ENABLED=true
APP_DEPLOYMENT_KIND=public-demo
APP_DEMO_BROWSER_ORIGIN=https://<approved-pages-domain>
# Generate 32 random bytes as canonical Base64URL (43 chars) for the server-only binding.
# Supply via secret settings to both the Pages Function and backend, never VITE_* or build args.
DEMO_GATEWAY_SECRET=
# Render supplies PORT; this value is only a local runtime example.
PORT=10000

# Provision the schema separately. Runtime validation must never create/update it.
DB_URL=jdbc:mysql://<database-host>:4000/<database>?sslMode=VERIFY_IDENTITY
DB_USERNAME=
DB_PASSWORD=
JPA_DDL_AUTO=validate

# Redis protocol over verified TLS; these are not REST credentials.
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true

# Fresh deployment-specific signing material, supplied only through runtime secrets.
JWT_SECRET=
JWT_ACCESS_SECONDS=300
JWT_REFRESH_SECONDS=3600
JWT_ISSUER=moneytoad-public-demo
# Required construction-only placeholder. Demo Chart must never call AI.
AI_BASE_URL=http://127.0.0.1:9

# These defaults are already defined only in the Docker runtime stage.
# Override at runtime only after measuring the constrained application container.
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+UseSerialGC -XX:ActiveProcessorCount=1 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Seoul

# Must equal the explicitly provisioned demo_capacity.max_visitors; never auto-updated.
DEMO_MAX_VISITORS=1000
