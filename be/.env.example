# Explicit local-demo example. Supply fresh secrets and dedicated local services.
# This file is documentation; the application does not load it automatically.
SPRING_PROFILES_ACTIVE=demo
APP_DEMO_ENABLED=true
APP_DEPLOYMENT_KIND=local-demo
APP_DEMO_BROWSER_ORIGIN=http://127.0.0.1:5173
DEMO_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/moneytoad_demo
DB_USERNAME=
DB_PASSWORD=
# Safe default: never initialize an existing/shared database with create-drop.
JPA_DDL_AUTO=validate
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REQUIRED: generate a new random signing secret, at least 32 bytes; never commit it.
JWT_SECRET=
JWT_ACCESS_SECONDS=300
JWT_REFRESH_SECONDS=3600
JWT_ISSUER=moneytoad-demo
# REQUIRED for CsvClient construction even when demo Chart performs no AI calls.
# Loopback placeholder must be replaced with an owned adapter before any AI feature is enabled.
AI_BASE_URL=http://127.0.0.1:18081

# public-demo requires HTTPS and APP_DEMO_BROWSER_ORIGIN with the exact HTTPS origin.
# Legacy OAuth only: remove demo profile, set enabled=false and deployment.kind=standard.
# Supply the approved provider configuration below; no team server defaults are provided.
# SSAFY_CLIENT_ID=
# SSAFY_CLIENT_SECRET=
# SSAFY_CLIENT_NAME=ssafy
# SSAFY_AUTH_GRANT_TYPE=authorization_code
# SSAFY_REDIRECT_URI=
# SSAFY_SCOPES=
# SSAFY_CLIENT_AUTH_METHOD=client_secret_post
# SSAFY_AUTH_URI=
# SSAFY_TOKEN_URI=
# SSAFY_USER_INFO_URI=
# SSAFY_USER_NAME_ATTR=
